#!/bin/bash
# Port travels via EMP_PORT (read by peer_port()); only the party id is positional.
# It is EMP_PORT when set (ctest gives each two-party test its own) and 12345
# otherwise: a fixed port below the range the OS assigns to outgoing connections
# (32768 and up on Linux, 49152 and up on macOS), so no outgoing connection can
# be holding it. The listener sets SO_REUSEADDR, so back-to-back runs can
# re-bind it.
export EMP_PORT=${EMP_PORT:-12345}
(sleep 0.05; $1 1 ${@:2}) &  $1 2 ${@:2}
